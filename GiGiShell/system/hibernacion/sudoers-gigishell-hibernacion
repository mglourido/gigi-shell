# /etc/sudoers.d/gigishell-hibernacion — permite a GiGiShell cambiar el retardo de hibernación
# sin contraseña.
#
# NO se symlinkea: sudoers.d se lee como root y apuntarlo al árbol del usuario sería una escalada.
# Lo instala gigishell-hibernacion-setup.sh sustituyendo __GIGISHELL_USER__ por el usuario real y
# validándolo con `visudo -cf` antes de moverlo a su sitio.
#
# El NOPASSWD es lo que hace posible que el tiempo se edite desde Ajustes con un +/-: un diálogo de
# contraseña por cada pulsación del selector de minutos no lo tolera nadie, y el ajuste acabaría
# desactivado. El grant es mínimo: un solo helper root-owned, un solo verbo, y su argumento tiene
# que ser un número (el comodín de aquí abre la puerta, pero quien decide qué entra es el
# `[[ =~ ^[0-9]+$ ]]` del helper).
#
# `estado` NO está aquí a propósito: no escribe nada y funciona sin root, así que AGS lo llama
# directamente. Un grant que no hace falta es un grant que sobra.
Cmnd_Alias GIGISHELL_HIBERNACION = /usr/local/bin/gigishell-hibernacion retardo [0-9]*
__GIGISHELL_USER__ ALL=(root) NOPASSWD: GIGISHELL_HIBERNACION
