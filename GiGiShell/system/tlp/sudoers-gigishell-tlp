# /etc/sudoers.d/gigishell-tlp — permite a GiGiShell cambiar el perfil TLP sin contraseña.
#
# NO se symlinkea: sudoers.d se lee como root y apuntarlo al árbol del usuario sería una
# escalada. Lo instala install.sh (paso 6) sustituyendo __GIGISHELL_USER__ por el usuario real
# y validándolo con `visudo -cf` antes de moverlo a su sitio.
#
# El grant es DELIBERADAMENTE mínimo: solo el helper root-owned y solo con los dos argumentos
# fijos. No es una escalada porque /usr/local/bin/gigishell-tlp-apply y /etc/gigishell/tlp/*.conf son
# root-owned; el usuario no puede alterar lo que corre como root sin ser root ya.
Cmnd_Alias GIGISHELL_TLP = /usr/local/bin/gigishell-tlp-apply normal, /usr/local/bin/gigishell-tlp-apply ahorro
__GIGISHELL_USER__ ALL=(root) NOPASSWD: GIGISHELL_TLP
