[SddmGreeterTheme]
Name=gigios
Description=Saludador de GiGiShell (jake_the_dog, sobre sddm-astronaut-theme)
Author=keyitdev
Website=https://github.com/Keyitdev/sddm-astronaut-theme
License=GPL-3.0-or-later
Type=sddm-theme
# ConfigFile es RELATIVO al directorio del tema. Upstream trae diez variantes en
# Themes/*.conf y su setup.sh elige una reescribiendo esta línea con sed; aquí sólo
# viaja jake_the_dog, ya materializada en theme.conf, así que no hay nada que elegir.
ConfigFile=theme.conf
Screenshot=Backgrounds/jake_the_dog.png
MainScript=Main.qml
Theme-Id=gigios
Theme-API=2.0
QtVersion=6
